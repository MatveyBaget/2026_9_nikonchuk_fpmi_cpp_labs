int sum(int** matrix, int indexrows, int cols) {
	int sum = 0;
	int fist = -1, last = -1;
	for (int col = 0; col < cols; ++col) {
		if (matrix[indexrows][col] == 0) {
			if (fist == 0) {
				fist = col;
			}
			else {
				last = col;
			}
		}
	}
	if (fist >= 0 && last >= 0 && fist != last) {
		for (int col = fist + 1; col < last; ++col) {
			sum += matrix[indexrows][col];
		}
	}
	else {
		sum = -indexrows;
	}
	return sum;
}

int* creatmassiv(int** matrix1, int& rows, int& cols) {
	int* p = new int[rows];
	for (int i = 0; i < rows; ++i) {
		p[i] = sum(matrix1, i, cols);
	}
	return p;
}

