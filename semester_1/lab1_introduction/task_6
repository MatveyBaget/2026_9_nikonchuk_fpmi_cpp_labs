#include <iostream>
#include <windows.h> 

int main() {
   
    SetConsoleCP(65001);
    SetConsoleOutputCP(65001);

    int a, b, d;

    std::cout << "Введите начало отрезка a: ";
    std::cin >> a;
    std::cout << "Введите конец отрезка b: ";
    std::cin >> b;
    std::cout << "Введите разность d: ";
    std::cin >> d;

    std::cout << "\nРезультат:\n";

    int count = 0; 

    if (d > 0) {
        for (int toi = a; toi <= b; toi += d) {
            if (toi % 3 == 0) {
                std::cout << toi << " ";
                count++; 
            }
        }
    }
    else if (d < 0) {
        for (int toi = a; toi >= b; toi += d) {
            if (toi % 3 == 0) {
                std::cout << toi << " ";
                count++;
            }
        }
    }
    else {
        if (a % 3 == 0) {
            std::cout << a << " ";
            count++;
        }
    }
    if (count == 0) {
        std::cout << "Элементов, удовлетворяющих условию, не найдено.";
    }

    std::cout << std::endl;
    return 0;
}
